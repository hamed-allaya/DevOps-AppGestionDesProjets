pipeline {
    agent any
    environment {
        JAVA_HOME  = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH       = "/usr/lib/jvm/java-17-openjdk-amd64/bin:/usr/bin:${env.PATH}"
        MAVEN_OPTS = "-Xint -XX:+UseSerialGC -XX:UseAVX=0 -Xms512m -Xmx1024m"
    }
    stages {
        stage('1. Checkout Backend') {
            steps {
                checkout scm
            }
        }
        stage('2. Build & Test Backend') {
            steps {
                dir('backend') {
                    sh '/usr/bin/mvn clean package -DskipTests'
                }
                archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
            }
        }
        stage('3. Deploy Backend') {
            steps {
                sh """
                    pkill -f "app-backend.jar" || true
                    cp backend/target/*.jar /opt/app-backend/app-backend.jar
                    BUILD_ID=dontKillMe nohup /usr/lib/jvm/java-17-openjdk-amd64/bin/java -Xint -XX:+UseSerialGC -XX:UseAVX=0 -jar /opt/app-backend/app-backend.jar --server.port=8081 > /opt/app-backend/app.log 2>&1 &
                """
            }
        }
    }
}
